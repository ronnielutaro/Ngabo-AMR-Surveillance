# Root build-context exclusions (Issue #89)
# The ngabo-web build uses the repository root as its Docker context; the
# ngabo-core build uses services/core (see services/core/.dockerignore).
# Keep every context free of secrets, caches, and unrelated content while
# retaining the locked build inputs (workspace manifests, lockfiles, source).

# Dependencies / build output
node_modules/
.next/
out/
dist/
coverage/
artifacts/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/

# Environment / secrets / credentials
.env
.env.*
!.env.example
*.json-key
*credentials*.json
*service-account*.json
gha-creds-*.json
*.pem
*.key
id_rsa*
id_ed25519*

# Git / IDE / OS / editor
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# Local scratch / evidence staging
scratch/

# Logs
*.log
