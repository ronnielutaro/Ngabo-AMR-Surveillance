# Ngabo environment template — placeholder variable names only.
# Copy to `.env` and fill locally as needed. Never commit real values,
# credentials, API keys, or secrets.

# Google Cloud project and region used by the deployed services (later milestones)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# Gemini model identifier used by ngabo-core for bounded agentic reasoning (later milestones)
GEMINI_MODEL=

# Allow-listed external A1 coordination target — test/sandbox only (later milestones)
NGABO_ACTION_WEBHOOK_URL=
NGABO_ACTION_WEBHOOK_SECRET=
