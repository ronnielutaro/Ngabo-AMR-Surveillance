{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngabo.local/schemas/evidence_manifest.schema.json",
  "title": "Ngabo Approved Evidence Manifest",
  "description": "Machine-checkable provenance and integrity for the approved evidence corpus (Issue #51).",
  "type": "object",
  "required": ["manifest_version", "corpus_id", "corpus_sha256", "sources"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "corpus_id": { "type": "string", "minLength": 1 },
    "corpus_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "publisher",
        "canonical_title",
        "canonical_url",
        "publication_date",
        "source_version",
        "local_content_present",
        "local_content_type",
        "usage_basis_or_license",
        "attribution_required",
        "approved_for_retrieval",
        "notes",
        "retrieval_tags",
        "chunks"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
        "publisher": { "type": "string", "minLength": 1 },
        "canonical_title": { "type": "string", "minLength": 1 },
        "canonical_url": { "type": "string", "minLength": 1 },
        "publication_date": { "type": "string", "minLength": 1 },
        "source_version": { "type": "string", "minLength": 1 },
        "local_content_present": { "type": "boolean" },
        "local_content_type": {
          "type": "string",
          "enum": ["metadata", "indexing_summary", "excerpt", "full_text"]
        },
        "usage_basis_or_license": { "type": "string", "minLength": 1 },
        "attribution_required": { "type": "boolean" },
        "approved_for_retrieval": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 },
        "retrieval_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "chunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/chunk" }
        }
      }
    },
    "chunk": {
      "type": "object",
      "required": ["reference_id", "content_path", "content_sha256", "tags"],
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*::[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "content_path": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
