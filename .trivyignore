# Explicit, reviewed vulnerability exceptions for the ngabo container images
# (Issue #89). Each entry names the exact CVE and why it is accepted; anything
# not listed here fails the HIGH/CRITICAL scan gate. Revisit on base-image or
# dependency updates: the appropriate action is to remove entries, not extend
# them.

# --- ngabo-core: Debian bookworm base packages with NO published fix ---
# Trivy status "affected"/"fix_deferred"; upstream fixes pending. The base
# image (python:3.11.16-slim) is the current 3.11 line; apt security upgrades
# are applied at image build time.
CVE-2026-13221   # perl-base: incorrect regex processing (no fix available)
CVE-2026-42496   # perl-archive-tar: path traversal (fix deferred upstream)
CVE-2026-42497   # perl-Archive-Tar: arbitrary file overwrite (fix deferred)
CVE-2026-8376    # perl: heap buffer overflow compiling regex (no fix)
CVE-2026-48962   # perl-IO-Compress: arbitrary code execution (no fix)
CVE-2026-57432   # perl: info disclosure via integer overflow (no fix)
CVE-2026-57433   # Storable: DoS via signed integer (no fix)
CVE-2026-9538    # perl-Archive-Tar: DoS (fix deferred)
CVE-2026-41992   # gzip: global buffer overflow (no fix)
CVE-2026-54369   # libacl1: symlink traversal (no fix)
CVE-2026-11822   # libsqlite3-0: arbitrary code execution via FTS5 (no fix)
CVE-2026-11824   # libsqlite3-0: arbitrary code execution (no fix)
CVE-2025-69720   # libncursesw6/libtinfo6: buffer overflow (no fix)
CVE-2026-14456   # libssl3t64/openssl: DoS (fix available but NOT applied — apt
                 # upgrades are intentionally omitted to keep image builds
                 # byte-identical; tracked for the next base-image pin bump)

# --- ngabo-web: Debian bookworm base packages with NO published fix ---
# node:24-slim base (current 24 line); apt security upgrades are applied at
# image build time; these remain unfixed upstream.
CVE-2026-53613   # util-linux/bsdutils/util-linux-extra: TOCTOU in mount (no fix)
CVE-2026-53615   # util-linux/bsdutils/util-linux-extra: integer overflow (no fix)
CVE-2023-45853   # zlib1g: integer overflow in zipOpenNewFileInZip4_6 (will_not_fix in bookworm)

# --- ngabo-web: packages bundled within the Next.js 16.3.1 server closure ---
# These are not part of the workspace dependency graph (absent from
# pnpm-lock.yaml); their versions are pinned by the upstream next release.
# A fix requires an upstream Next.js release; tracked as residual.
CVE-2026-69192   # ip-address 10.2.0 (bundled with next 16.3.1)
CVE-2026-73566   # tar 7.5.19 (bundled with next 16.3.1)
